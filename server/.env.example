# Uraan Backend Configuration & SSLCOMMERZ Credentials

PORT=5000

# SSLCOMMERZ Credentials
# Set to 'false' for Sandbox testing, 'true' for Live production
IS_LIVE=false

# For testing, you can use your Sandbox store credentials from developer.sslcommerz.com
# Default public test credentials:
STORE_ID=testbox
STORE_PASSWD=qwerty

# Service URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/uraan?retryWrites=true&w=majority

# Stripe Credentials (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_CURRENCY=usd
STRIPE_WEBHOOK_SECRET=

